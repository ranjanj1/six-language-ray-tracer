[1.182, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[2C\u001b[1B\u001b[38;2;150;108;30m\u23f5\u23f5 auto mode on\u001b[38;2;102;102;102m (shift+tab to cycle) \u00b7 \u2190 for agents\u001b[39m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[>0q\u001b[?u\u001b]7501;?\u0007\u001b[c"]
[4.111, "\u001b[?25l\u001b[H\r\u001b[2C\u001b[37B[Pasted text #1 +12 lines]\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;102;102;102mpaste again to expand\u001b[39m\u001b[K\u001b[40;1H\u001b[38;29H\u001b[?25h"]
