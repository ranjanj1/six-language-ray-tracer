[31.365, "8;2;0;0;0mImag\u001b[11Gsize 400 x 225, 200 samples\u001b[39Gper\u001b[43Gpixel, max boun\u001b[59Ge d\u001b[63Gpth\u00a010.\u001b[39m      \r\u001b[4C\u001b[1B\u001b[38;2;0;0;0mWrite the image to \u001b[38;2;87;105;247mout.ppm\u001b[38;2;0;0;0m in\u001b[35Gthe PPM (P3) forma\u001b[54G des\u001b[59Grib\u001b[63Gd in \u001b[38;2;87;105;247mspec.md\u001b[38;2;0;0;0m.\r\u001b[4C\u001b[1BSingle file, standard\u001b[27Gl\u001b[29Gbrary only, \u001b[42Go third-party packages.\r\u001b[2C\u001b[1B- It must build and run with: node main.js\r\u001b[2C\u001b[1B\u001b[39m                                                  \r\u001b[1B  \u001b[38;2;0;0;0mWhen it runs and writes \u001b[38;2;87;105;247mout.ppm\u001b[38;2;0;0;0m, stop and tell me.\u001b[39m                                                                    \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running cat > main.js <<'EOF'\u001b[33G'use\u001b[38Gstrict';\u001b[47Gconst\u001b[53Gfs\u001b[56G=\u001b[58Grequ\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > main.js <<'EOF'\r\u001b[5C\u001b[1B'use strict';\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mconst fs = require('fs');\r\u001b[5C\u001b[1B// xorshift32\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mlet state = 42;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102"]
