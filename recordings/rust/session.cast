[32.416, "\u001b[?25l\u001b[H\r\u001b[20B \u001b[3G\u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mmain.rs\u001b[39m builds with \u001b[38;2;87;105;247mrustc -O main.rs -o main\u001b[39m,\u001b[49Gand\u001b[53G\u001b[38;2;87;105;247m./main\u001b[60G\u001b[39mran\u001b[64Gin\u001b[67Gabout\u001b[73G2\u001b[75Gseconds\u001b[83Gand\u001b[87Gwrote\u001b[93G\u001b[38;2;87;105;247mout.ppm\u001b[39m.\u001b[102GI\u001b[104Ghaven't\u001b[112Gtried\u001b[118Gto\r\u001b[2C\u001b[1Brun it against anything\u001b[27Gbeyond\u001b[34Gthat\u001b[39Gbuild\u001b[45Gand\u001b[49Grun.\u001b[54GI\u001b[56Galso\u001b[61Gcompared\u001b[70Gthe\u001b[74Goutput\u001b[81Gwith\u001b[86G\u001b[38;2;87;105;247mreference.ppm\u001b[100G\u001b[39min\u001b[103Gthe\u001b[107Gdirectory,\u001b[118Gand\r\u001b[2C\u001b[1Bthe two match exactly. The largest difference\u001b[49Gon\u001b[52Gany\u001b[56Gchannel\u001b[64Gis\u001b[67G0.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIt's a single file using only\u001b[33Gthe\u001b[37Gstandard\u001b[46Glibrary.\u001b[55GIt\u001b[58Gfollows\u001b[66G\u001b[38;2;87;105;247mspec.md\u001b[39m,\u001b[75G\u001b[38;2;87;105;247mscene.md\u001b[84G\u001b[39mand\u001b[88G\u001b[38;2;87;105;247mrng.md\u001b[95G\u001b[39mwith\u001b[100Gseed\u001b[105G42,\u001b[109Gat\u001b[112G400\u00d7225,\r\u001b[2C\u001b[1B200 samples per pixel and d"]
[32.417, "epth 10.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mrng.md\u001b[10G\u001b[39msays\u001b[15G\"samples\u001b[24G0\u001b[26Gthrough\u001b[34G19\",\u001b[39Gbut\u001b[43G\u001b[38;2;87;105;247mspec.md\u001b[51G\u001b[39mand\u001b[55Gyour\u001b[60Grequirements\u001b[73Gsay\u001b[77G200.\u001b[82GI\u001b[84Gused\u001b[89G200,\u001b[94Gand\u001b[98Gthe\u001b[102Gexact\u001b[108Gmatch\u001b[114Gwith\r\u001b[2C\u001b[1Bthe\u001b[7Greference\u001b[17Gsuggests\u001b[26Gthat\u001b[31Gwas\u001b[35Gright.\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[3GWorked for 28s \u00b7 done 3:15 PM\r\u001b[2B\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[38C\u001b[2B\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h"]
[40.152, "\u001b(B\u000f\u001b[?2004h\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[40.155, "\u001b[?25l\u001b[H\r\u001b[2C\u001b[39B\u001b[38;2;102;102;102mPress Ctrl-C again to exit\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h"]
[40.965, "\u001b[?25l\u001b[H\r\u001b[2C\u001b[39B\u001b[38;2;150;108;30m\u23f5\u23f5 auto mode on\u001b[38;2;102;102;102m (shift+tab to cycle)\u001b[39m\u001b[40;1H\u001b[38;3H\u001b[?25h"]
[41.188, "\u001b[?25l\u001b[H\r\u001b[2C\u001b[39B\u001b[38;2;102;102;102mPress Ctrl-C again to exit\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h"]
