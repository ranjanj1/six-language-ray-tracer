[31.848, "\u001b[?25l\u001b[H\u001b[48;2;240;240;240m                               \r\u001b[2C\u001b[1B\u001b[38;2;0;0;0mFollow the algorithm in the attached \u001b[38;2;87;105;247mspec.md\u001b[38;2;0;0;0m (based on \"Ray Tracing in One Weekend\"): spheres with diffuse, metal\r\u001b[2C\u001b[1Band glass m\u001b[15Gterials,\u001b[24Ga fix\u001b[30Gd camera,\u001b[40Gthe scene described in\u001b[63G\u001b[38;2;87;105;247mscene.md\u001b[38;2;0;0;0m, and th\u001b[80G ra\u001b[85Gom numb\u001b[94G generator de\u001b[108Gcrib\u001b[113Gd in\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mrng.md\u001b[38;2;0;0;0m with s\u001b[17Ged 42.\u001b[39m                                                                                              \r\u001b[2C\u001b[1B                    \r\u001b[2C\u001b[1B\u001b[38;2;0;0;0mRequirements:\r\u001b[2C\u001b[1B- Imag\u001b[10G size 400 x 225, 200 samples per pixel, max bounce depth\u00a010.\r\u001b[4C\u001b[1BWrit\u001b[11Gthe image to \u001b[38;2;87;105;247mout.ppm\u001b[38;2;0;0;0m in the\u001b[39GPPM\u001b[43G(P3) format des\u001b[59Grib\u001b[63Gd in \u001b[38;2;87;105;247mspec.md\u001b[38;2;0;0;0m.\r\u001b[4C\u001b[1BSingle file, standard library\u001b[35Gonly, no third-par\u001b[54Gy pa\u001b[59Gkag\u001b[63Gs.\u001b[39m           \r\u001b[4C\u001b[1B\u001b[38;2;0;0;0mIt must build"]
[31.849, " and run\u001b[27Gw\u001b[29Gth: python3\u001b[41Gmain.py\u001b[39m                 \r\u001b[2C\u001b[1B                                             \r\u001b[2C\u001b[1B\u001b[38;2;0;0;0mWhen it runs and writes \u001b[38;2;87;105;247mout.ppm\u001b[38;2;0;0;0m, stop and tell me.\r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gstart\u001b[14Gby\u001b[17Glooking\u001b[25Gfor\u001b[29Gthe\u001b[33Gspec\u001b[38Gfiles.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning\u001b[11Gcat\u001b[15G>\u001b[17Gmain.py\u001b[25G<<'EOF'\u001b[33Gfrom\u001b[38Gmath\u001b[43Gimport\u001b[50Gsqrt,\u001b[56Gfloor\u2026\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1C\u001b[1B \u23bf  $ cat > main.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mfrom math \u001b[17Gmport sqrt, floor, inf\r\u001b[5C\u001b[1BW, H, SAMPLES, DEPTH =\u001b[29G400, 225, 200, 10\r\u001b[5C\u001b[1Bstate\u001b[12G= 42\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mdef rnd():\r\u001b[5C\u001b[1Bglobal state\r\u001b[5C\u001b[1Bs = state\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;102;102;102m^= (s << 13) & 0xFFFFFFFF\r\u001b[10C\u001b[1Bs >> 17\u001b[39m\u001b[K\r\u001b[10C\u001b[1B\u001b[38;2;102;102;102m(s << 5) & 0xFFFFFFFF\r\u001b[6C\u001b[1Btate =\u001b[14Gs\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mreturn s / 4294967296.0\r\u001b[5C\u001b[1Bd\u001b[8Gf \u001b[11Gand_unit():\u001b["]
