[169.12, "\u001b[?25l\u001b[H\r\u001b[2C\u001b[39B\u001b[38;2;150;108;30m\u23f5\u23f5 auto mode on\u001b[38;2;102;102;102m (shift+tab to cycle)\u001b[39m\u001b[40;1H\u001b[38;3H\u001b[?25h"]