[32.884, "\u001b[?25l\u001b[H\r\u001b[20B \u001b[3G\u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mmain.cpp\u001b[39m builds with \u001b[38;2;87;105;247mc++ -std=c++17 -O2 main.cpp -o main\u001b[39m,\u001b[61Gand\u001b[65G\u001b[38;2;87;105;247m./main\u001b[72G\u001b[39mruns\u001b[77Gin\u001b[80Gabout\u001b[86G1.6\u001b[90Gseconds\u001b[98Gand\u001b[102Gwrites\u001b[109G\u001b[38;2;87;105;247mout.ppm\u001b[39m.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gcompared \u001b[38;2;87;105;247mout.ppm\u001b[39m to\u001b[25Gthe\u001b[29G\u001b[38;2;87;105;247mreference.ppm\u001b[43G\u001b[39min\u001b[46Gyour\u001b[51Gdirectory.\u001b[62GIt\u001b[65Ghas\u001b[69Gthe\u001b[73Gsame\u001b[78Gsize\u001b[83Gand\u001b[87Gheader,\u001b[95Gand\u001b[99Gthe\u001b[103Glargest\r\u001b[2C\u001b[1Bper-channel difference\u001b[26Gis\u001b[29G0.\u001b[32GIn\u001b[35Gother\u001b[41Gwords,\u001b[48Git\u001b[51Gmatches\u001b[59Gexactly.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mrng.md\u001b[39m says \"samples\u001b[24G0\u001b[26Gthrough\u001b[34G19\",\u001b[39Gwhich\u001b[45Gconflicts\u001b[55Gwith\u001b[60Gthe\u001b[64G200\u001b[68Gsamples\u001b[76Gper\u001b[80Gpixel\u001b[86Gin\u001b[89G\u001b[38;2;87;105;247mspec.md\u001b[97G\u001b[39mand\u001b[101Gyour\u001b[106Grequest.\u001b[115GI\u001b[117Gused\r\u001b[2C\u001b[1B200.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b"]
[32.885, "[1BI\u001b[5Galso turned off floating-point contraction in the source with pragmas. That stops the\u001b[91Gcompiler\u001b[100Gfrom\u001b[105Gfusing\r\u001b[2C\u001b[1Bmultiply-adds, which\u001b[24G\u001b[38;2;87;105;247mspec.md\u001b[32G\u001b[39mforbids,\u001b[41Geven\u001b[46Gthough\u001b[53Gthe\u001b[57Gbuild\u001b[63Gcommand\u001b[71Gcan't\u001b[77Gpass\u001b[82Ga\u001b[84Gflag\u001b[89Gfor\u001b[93Git.\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[3GSaut\u00e9ed for 28s \u00b7 done 3:14 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[38C\u001b[2B\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h"]
[41.124, "\u001b(B\u000f\u001b[?2004h\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[41.127, "\u001b[?25l\u001b[H\r\u001b[2C\u001b[39B\u001b[38;2;102;102;102mPress Ctrl-C again to exit\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h"]
[41.939, "\u001b[?25l\u001b[H\r\u001b[2C\u001b[39B\u001b[38;2;150;108;30m\u23f5\u23f5 auto mode on\u001b[38;2;102;102;102m (shift+tab to cycle)\u001b[39m\u001b[40;1H\u001b[38;3H\u001b[?25h"]
[42.159, "\u001b[?25l\u001b[H\r\u001b[2C\u001b[39B\u001b[38;2;102;102;102mPress Ctrl-C again to exit\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h"]
[42.965, "\u001b[?25l\u001b[H\r\u001b[2C\u001b[39B\u001b[38;2;150;108;30m\u23f5\u23f5 auto mode on\u001b[38;2;102;102;102m (shift+tab to cycle)\u001b[39m\u001b[40;1H\u001b[38;3H\u001b[?25h"]